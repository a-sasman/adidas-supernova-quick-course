---
import CourseLayout from "../layouts/CourseLayout.astro";
import QuickCheck from "../components/QuickCheck.astro";
import VersusLogo from "../components/VersusLogo.astro";
import { courseData } from "../data/versus-course";
---

<CourseLayout title={courseData.meta.title} description={courseData.meta.description}>
  <div class="course-page">
    <header class="site-header" id="top">
      <nav class="course-nav container" aria-label="Course sections">
        <a class="brand-link" href="#overview"><VersusLogo /></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="course-links">
          <span class="sr-only">Toggle course navigation</span>
          <span></span><span></span><span></span>
        </button>
        <div class="course-links" id="course-links">
          {courseData.nav.map((item, index) => (
            <a href={`#${item.id}`} class:list={[index === 0 && "active"]}>{item.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero container" id="overview" data-nav-section>
        <div class="hero-copy">
          <h1>{courseData.welcome.title}</h1>
          {courseData.welcome.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="hero-image-wrap">
          <img src={courseData.welcome.image} alt={courseData.welcome.imageAlt} />
        </div>
      </section>

      <section class="range-section" id="product-range" data-nav-section>
        <div class="container section-heading section-heading--dark-text">
          <h2>{courseData.range.title}</h2>
          <p>{courseData.range.intro}</p>
          <span class="heading-rule" aria-hidden="true"></span>
        </div>
        <div class="container range-grid">
          {courseData.range.cards.map((card) => (
            <article class="range-card">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </article>
          ))}
        </div>
        <div class="container range-check-wrap">
          <QuickCheck
            question="A customer says they need socks for trail running and hiking. Which range should you recommend?"
            answer="Trail Running. It gives trail runners and hikers the grip and durability they need."
          />
        </div>
      </section>

      <section class="match-section dark-section" id="accessories-ecosystem" data-nav-section>
        <div class="container section-heading section-heading--light-text">
          <h2>{courseData.match.title}</h2>
          <p>{courseData.match.intro}</p>
          <p class="instruction"><em>{courseData.match.instruction}</em><br /><strong><em>{courseData.match.action}</em></strong></p>
          <span class="heading-rule" aria-hidden="true"></span>
        </div>
        <div class="container method-grid">
          {courseData.match.cards.map((card) => (
            <button class="method-card" type="button" aria-pressed="false">
              <img src={card.image} alt={card.alt} />
              <span class="method-overlay"></span>
              <span class="method-front"><strong><em>{card.title}</em></strong></span>
              <span class="method-back"><strong>{card.title}</strong><span>{card.description}</span></span>
            </button>
          ))}
        </div>
        <div class="container conversation">
          <h3>Example conversation</h3>
          <p>{courseData.match.conversation}</p>
        </div>
        <div class="container">
          <QuickCheck
            variant="light"
            label="Quick check: Ask first"
            question="A customer says, “I am not sure which sock I need.” What should you do first?"
            answer="Ask what the customer will use the socks for."
          />
        </div>
      </section>

      <section class="benefits-section" id="how-to-sell" data-nav-section>
        <div class="container section-heading section-heading--dark-text">
          <h2>{courseData.benefits.title}</h2>
          <p>{courseData.benefits.intro}</p>
          <p>{courseData.benefits.body}</p>
          <span class="heading-rule" aria-hidden="true"></span>
        </div>
        <div class="container benefit-cards">
          <article class="info-card">
            <span class="info-icon" aria-hidden="true">◌</span>
            <h3>Say it simply</h3>
            <p>{courseData.benefits.simple}</p>
          </article>
          <div class="info-card quick-card">
            <span class="info-icon" aria-hidden="true">♢</span>
            <h3>Quick Check:</h3>
            <p>Which explanation is easiest for a customer to understand?</p>
            <button class="reveal-answer" type="button" aria-expanded="false">Reveal answer</button>
            <p class="inline-answer" hidden>This helps move sweat away from your foot so you feel more comfortable while moving.</p>
          </div>
        </div>
      </section>

      <section class="concerns-section dark-section">
        <div class="container section-heading section-heading--light-text">
          <h2>{courseData.concerns.title}</h2>
          <p>{courseData.concerns.intro}</p>
          <span class="heading-rule" aria-hidden="true"></span>
        </div>
        <div class="container response-model">
          <h3>{courseData.concerns.modelTitle}</h3>
          <div class="model-line" aria-hidden="true"></div>
          <div class="model-grid">
            {courseData.concerns.model.map((step) => (
              <article><h4>{step.title}</h4><p>{step.description}</p></article>
            ))}
          </div>
        </div>
      </section>

      <section class="concern-example-section">
        <div class="container example-card">
          <h3>Customer Concern Example</h3>
          <p>{courseData.concerns.example}</p>
        </div>
        <div class="container">
          <QuickCheck
            label="Quick check: Ask first"
            question="A customer says, “I am not sure which sock I need.” What should you do first?"
            answer="Ask what the customer will use the socks for."
          />
        </div>
      </section>

      <section class="assessment-section" id="activity" data-nav-section>
        <div class="container assessment-shell">
          <h2>Assessment</h2>
          <div class="assessment-stage" aria-live="polite">
            {courseData.assessment.map((question, questionIndex) => (
              <article class:list={["assessment-slide", questionIndex !== 0 && "is-hidden"]} data-question={questionIndex}>
                <div class="assessment-question">
                  <p><span>{questionIndex + 1}.</span> {question.question}</p>
                  <div class="assessment-feedback" aria-live="polite"></div>
                </div>
                <div class="assessment-options">
                  {question.options.map((option, optionIndex) => (
                    <button
                      type="button"
                      data-option={optionIndex}
                      data-correct={optionIndex === question.correctIndex ? "true" : "false"}
                      data-feedback={question.feedback}
                    >
                      <strong>{String.fromCharCode(65 + optionIndex)}.</strong> {option}
                    </button>
                  ))}
                </div>
              </article>
            ))}
          </div>
          <div class="assessment-controls">
            <span class="question-count">Question <strong>1</strong> of {courseData.assessment.length}</span>
            <button type="button" class="assessment-prev" aria-label="Previous question">‹</button>
            <button type="button" class="assessment-next" aria-label="Next question">›</button>
          </div>
        </div>
      </section>
    </main>

    <footer class="course-footer container">
      <p>{courseData.footer.completion}</p>
      <a href={courseData.footer.url}>{courseData.footer.button} <span aria-hidden="true">›</span></a>
    </footer>

    <a class="back-to-top" href="#top" aria-label="Back to top">⌃</a>
  </div>

  <script>
    const storageKey = "versus-socks-course-progress-v1";
    const navToggle = document.querySelector(".nav-toggle");
    const links = document.querySelector(".course-links");
    navToggle?.addEventListener("click", () => {
      const open = navToggle.getAttribute("aria-expanded") === "true";
      navToggle.setAttribute("aria-expanded", String(!open));
      links?.classList.toggle("is-open", !open);
    });
    links?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      navToggle?.setAttribute("aria-expanded", "false");
      links.classList.remove("is-open");
    }));

    document.querySelectorAll(".method-card").forEach((card) => {
      card.addEventListener("click", () => {
        const pressed = card.getAttribute("aria-pressed") === "true";
        card.setAttribute("aria-pressed", String(!pressed));
      });
    });

    document.querySelectorAll(".reveal-answer").forEach((button) => {
      button.addEventListener("click", () => {
        const answer = button.parentElement?.querySelector(".inline-answer");
        const open = button.getAttribute("aria-expanded") === "true";
        button.setAttribute("aria-expanded", String(!open));
        if (answer instanceof HTMLElement) answer.hidden = open;
        button.textContent = open ? "Reveal answer" : "Hide answer";
      });
    });

    const slides = Array.from(document.querySelectorAll(".assessment-slide"));
    const count = document.querySelector(".question-count strong");
    const previous = document.querySelector(".assessment-prev");
    const next = document.querySelector(".assessment-next");
    let current = 0;
    try {
      const saved = JSON.parse(localStorage.getItem(storageKey) || "{}");
      if (Number.isInteger(saved.current)) current = Math.min(Math.max(saved.current, 0), slides.length - 1);
    } catch {}

    const showQuestion = (index) => {
      current = Math.min(Math.max(index, 0), slides.length - 1);
      slides.forEach((slide, slideIndex) => slide.classList.toggle("is-hidden", slideIndex !== current));
      if (count) count.textContent = String(current + 1);
      if (previous instanceof HTMLButtonElement) previous.disabled = current === 0;
      if (next instanceof HTMLButtonElement) next.disabled = current === slides.length - 1;
      localStorage.setItem(storageKey, JSON.stringify({ current }));
    };

    slides.forEach((slide) => {
      slide.querySelectorAll("[data-option]").forEach((option) => {
        option.addEventListener("click", () => {
          const feedback = slide.querySelector(".assessment-feedback");
          const correct = option.getAttribute("data-correct") === "true";
          slide.querySelectorAll("[data-option]").forEach((item) => item.classList.remove("selected", "correct", "incorrect"));
          option.classList.add("selected", correct ? "correct" : "incorrect");
          if (feedback) {
            feedback.textContent = correct ? `Correct. ${option.getAttribute("data-feedback") || ""}` : "Not quite. Review the course content and try again.";
            feedback.className = `assessment-feedback ${correct ? "is-correct" : "is-incorrect"}`;
          }
        });
      });
    });
    previous?.addEventListener("click", () => showQuestion(current - 1));
    next?.addEventListener("click", () => showQuestion(current + 1));
    showQuestion(current);

    const sectionLinks = Array.from(document.querySelectorAll(".course-links a"));
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      sectionLinks.forEach((link) => link.classList.toggle("active", link.getAttribute("href") === `#${visible.target.id}`));
    }, { rootMargin: "-20% 0px -65%", threshold: [0.05, 0.3, 0.6] });
    document.querySelectorAll("[data-nav-section]").forEach((section) => observer.observe(section));
  </script>
</CourseLayout>
