---
interface Props {
  question: string;
  answer: string;
  variant?: "dark" | "light";
  label?: string;
}

const { question, answer, variant = "dark", label = "Quick Check:" } = Astro.props as Props;
---

<details class:list={["quick-check", `quick-check--${variant}`]}>
  <summary>
    <span class="quick-check-icon" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 34h12M20 39h8M24 5a13 13 0 0 0-7.6 23.5c1 .7 1.6 1.8 1.6 3V34h12v-2.5c0-1.2.6-2.3 1.6-3A13 13 0 0 0 24 5Z" />
        <path d="M4 14l5 2M44 14l-5 2M10 5l4 4M38 5l-4 4" />
      </svg>
    </span>
    <span class="quick-check-copy">
      <strong><em>{label}</em></strong>
      <span>{question}</span>
      <small>Tap to reveal the answer</small>
    </span>
    <span class="quick-check-toggle" aria-hidden="true">+</span>
  </summary>
  <div class="quick-check-answer"><strong>Answer:</strong> {answer}</div>
</details>
